##############################################################################
# cvx-chat — Environment Variables
#
# 1. Copy this file: cp .env.example .env
# 2. Fill in the values below (especially INSTANCE_SECRET)
# 3. Never commit .env to source control — it contains secrets!
##############################################################################

# ==============================================================================
# CONVEX INSTANCE IDENTITY
# ==============================================================================

# A short human-readable name for this deployment (no spaces, use hyphens)
INSTANCE_NAME=cvx-chat

# REQUIRED: A long random secret used to sign admin keys.
# Generate with: openssl rand -hex 32
# After changing this value you must regenerate the admin key.
INSTANCE_SECRET=


# ==============================================================================
# CONVEX BACKEND PORTS
# ==============================================================================

# Next.js Frontend port
FRONTEND_PORT=3000

# Convex backend API port (used by your frontend)
PORT=3210

# Convex HTTP Actions proxy port
SITE_PROXY_PORT=3211

# Convex Dashboard port
DASHBOARD_PORT=6791


# ==============================================================================
# CONVEX ORIGIN URLs
# These must be reachable from your browser when accessing the app.
# For local dev, keep 127.0.0.1. For production, use your public domain.
# ==============================================================================

CONVEX_CLOUD_ORIGIN=http://127.0.0.1:3210
CONVEX_SITE_ORIGIN=http://127.0.0.1:3211
NEXT_PUBLIC_DEPLOYMENT_URL=http://127.0.0.1:3210


# ==============================================================================
# POSTGRESQL
# ==============================================================================

POSTGRES_DB=convex
POSTGRES_USER=convex
# REQUIRED: Change this to a strong password before production use!
POSTGRES_PASSWORD=convexsecret
POSTGRES_PORT=5432


# ==============================================================================
# MINIO (S3-COMPATIBLE OBJECT STORAGE)
# ==============================================================================

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# MinIO root credentials — used both by MinIO itself and by Convex as AWS keys
# REQUIRED: Change these before production use!
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# AWS region — MinIO doesn't care about this value, but Convex requires it
AWS_REGION=us-east-1

# Bucket names — these will be auto-created by the minio-init container
S3_STORAGE_FILES_BUCKET=convex-files
S3_STORAGE_MODULES_BUCKET=convex-modules
S3_STORAGE_EXPORTS_BUCKET=convex-exports
S3_STORAGE_SEARCH_BUCKET=convex-search
S3_STORAGE_SNAPSHOT_IMPORTS_BUCKET=convex-snapshot-imports


# ==============================================================================
# TUNING (optional, defaults are fine for local/small deployments)
# ==============================================================================

APPLICATION_MAX_CONCURRENT_MUTATIONS=16
APPLICATION_MAX_CONCURRENT_NODE_ACTIONS=16
APPLICATION_MAX_CONCURRENT_QUERIES=16
APPLICATION_MAX_CONCURRENT_V8_ACTIONS=16

# Set to "false" to expose a Prometheus-compatible /metrics endpoint
DISABLE_METRICS_ENDPOINT=true

# Log level: error, warn, info, debug, trace
RUST_LOG=info

# Document retention delay in seconds (default: 2 days = 172800)
DOCUMENT_RETENTION_DELAY=172800

# Set to "true" to allow HTTP connections without SSL (for local dev)
DO_NOT_REQUIRE_SSL=true

# Set to "true" to stop sending anonymous usage data to Convex
DISABLE_BEACON=true
